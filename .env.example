# Cookie-signed JWT. Change this in any real deployment.
AUTH_SECRET=dev-only-change-me-please-use-32b!!

# mock (default canned) | cli/grok (`grok -p`) | acp (live stdio streaming) | remote (throwing stub)
GROK_ADAPTER=acp

# Live ACP is stdio: `grok agent --always-approve stdio`. Never bind or publish an ACP port.
# GROK_ACP_URL is unused until session/serve is wired.
# GROK_ACP_URL=http://127.0.0.1:8080

# GROK_HOME is grok's config dir (~/.grok), NOT $HOME. HOME defaults to /opt/buildinator.
GROK_HOME=/opt/buildinator/.grok
GROK_BIN=/opt/buildinator/.grok/bin/grok
# HOME=/opt/buildinator
