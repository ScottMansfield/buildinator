# Cookie-signed JWT. Change this in any real deployment.
AUTH_SECRET=dev-only-change-me-please-use-32b!!

# mock (default) | remote (ACP stub — grok is not spawned yet)
GROK_ADAPTER=mock

# Loopback only. Never publish this port; HTTPS web UI is the only
# internet-facing socket. Sidecar binds 127.0.0.1.
GROK_ACP_URL=http://127.0.0.1:8080
