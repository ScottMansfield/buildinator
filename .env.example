# Cookie-signed JWT. Change this in any real deployment.
AUTH_SECRET=dev-only-change-me-please-use-32b!!

# mock (default canned) | cli/grok (`grok -p`) | acp (live grok agent serve WS) | remote (throwing stub)
GROK_ADAPTER=acp

# Live ACP is loopback WebSocket: `grok agent --always-approve serve --bind 127.0.0.1:2419`
# Next.js is the only public HTTP. Do not publish 2419. Caddy must not proxy grok.
# Stale http://127.0.0.1:8080 values are ignored; this defaults to ws://127.0.0.1:2419/ws.
GROK_ACP_URL=ws://127.0.0.1:2419
# Auth: Authorization: Bearer <GROK_AGENT_SECRET>. Do not put --secret on grok argv when this is set.
GROK_AGENT_SECRET=

# GROK_HOME is grok's config dir, NOT $HOME. Set it separately (not inferred).
# Local-dev example: GROK_HOME=/opt/buildinator/.grok
# VM with BUILDINATOR_ROOT: GROK_HOME=/mnt/buildinator/grok
GROK_HOME=/mnt/buildinator/grok
GROK_BIN=/mnt/buildinator/grok/bin/grok
# HOME=/opt/buildinator

# Persistent disk root so sqlite, workspaces, and grok state survive VM replacement.
# Unset in local-dev: sqlite+transcripts at ./data, workspaces at ./data/sandboxes.
# On the VM:
BUILDINATOR_ROOT=/mnt/buildinator
# Layout:
#   $BUILDINATOR_ROOT/data      sqlite + transcripts
#   $BUILDINATOR_ROOT/projects  workspaces (not nested under data/)
#   $BUILDINATOR_ROOT/grok      GROK_HOME (login + ACP session blobs)
# GROK_HOME is still set separately — not inferred from BUILDINATOR_ROOT.
